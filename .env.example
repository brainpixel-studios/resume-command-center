# Resume Command Center — AI provider config.
# Copy to `.env` (gitignored) and fill in whichever provider(s) you want.
# CLI providers (Claude, Gemini, Codex) need NO key here — they are auto-detected on your PATH.

# --- OpenAI-compatible providers: set the key for the one(s) you use ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o            # optional model override

# XAI_API_KEY=xai-...            # Grok (xAI)
# MISTRAL_API_KEY=...
# GROQ_API_KEY=...
# DEEPSEEK_API_KEY=...

# --- Local Ollama (no key; opt in by setting a model) ---
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# --- Backend port (optional; defaults to 4010) ---
# RCC_PORT=4010
